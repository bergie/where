  "keywords": [
    "location",
    "coordinates",
    "geo",
    "point",
    "gis"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/bergie/where.git"
  },
  "scripts": {
